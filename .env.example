# ---------------------------------------------------------------------------
# Rahigh Khabar frontend — environment variables
# Copy to .env.local for development. On Railway, set these as service variables.
# ---------------------------------------------------------------------------

# Origin of the backend API. Exact origin, no trailing slash, no path.
# lib/api.ts refuses to call any URL outside this origin.
#
# IMPORTANT (Stage 7): this must also be present at BUILD time, not just at
# runtime. Two reasons:
#   1. NEXT_PUBLIC_* values are inlined into the client bundle during the build.
#   2. next.config.ts derives the next/image allow-list from it, so a missing
#      value at build time means backend cover images are blocked at runtime.
#
# Local development against a backend on port 3000:
NEXT_PUBLIC_API_URL=http://localhost:3000

# Production example (must match the backend's own PUBLIC_API_URL exactly, and
# the backend's CORS_ORIGIN must in turn allow this frontend's origin):
# NEXT_PUBLIC_API_URL=https://api.example.com

# ---------------------------------------------------------------------------
# Stage 8 (admin panel)
# ---------------------------------------------------------------------------

# DEPLOYMENT CONSTRAINT, not a variable: the admin panel needs the session
# cookie to reach the API, and the backend sets it host-only to the API origin
# with SameSite=Lax. The frontend and the backend must therefore be served from
# the same registrable domain (e.g. www.example.com + api.example.com). Two
# unrelated domains (a *.up.railway.app frontend calling a *.up.railway.app
# backend is fine only because they share railway.app, and custom domains must
# be paired deliberately) will authenticate in Postman and fail in the browser,
# because the cookie is simply never sent.

# Maximum upload size the picker enforces BEFORE sending a file, in bytes.
# Must equal the backend's MAX_UPLOAD_SIZE_BYTES. If they disagree the backend
# still wins (it answers 413 FILE_TOO_LARGE); this value only decides whether
# the editor is told before or after the upload. Default when unset: 5 MiB.
# NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES=5242880

# ---------------------------------------------------------------------------
# Stage 9 (SEO layer)
# ---------------------------------------------------------------------------

# The public origin of THIS frontend. Origin only: no trailing slash, no path.
#
# Everything the SEO layer emits is built from it - the canonical URL on every
# page, og:url, the share-card URL, every <loc> in /sitemap.xml, and the
# Sitemap: line in /robots.txt.
#
# REQUIRED AT BUILD TIME AS WELL AS AT RUNTIME. It is inlined into the client
# bundle (NEXT_PUBLIC_*), and a production build FAILS when it is missing -
# deliberately, because canonical tags pointing at localhost are worse than a
# failed build. `next dev` falls back to http://localhost:3000 with a warning.
#
# This is NOT the backend origin: keep it different from NEXT_PUBLIC_API_URL.
# Locally the frontend usually runs on 3001, because the backend takes 3000.
#
# It should match the backend's own PUBLIC_SITE_URL, which the backend uses for
# its own /sitemap.xml and /robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Production example:
# NEXT_PUBLIC_SITE_URL=https://example.com
